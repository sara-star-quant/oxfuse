{
  "about": "Machine-readable numeric contract: one row per operator and backend. `cargo test -p oxfuse --test contract_matrix` checks the rows against `Op::ALL_NAMES`, that every evidence path exists and every named test is in its file.",
  "levels": {
    "exact": "Bit-identical to the reference for every input; all NaNs count as one value.",
    "exact-on-normal-values": "Bit-identical to the reference when the operands and the true result are zero or normal numbers.",
    "fused-defined": "Defined as one fused multiply-add per step in ascending k from +0.0; bit-identical to the reference on the tested platforms.",
    "own-math": "Computed with the project's own exp; bit-identical to the reference on the tested platforms and pinned by a hash over all 2^32 inputs.",
    "bounded": "Within a stated rounding bound of the float64 result; bit-identical to the reference on adapters that fuse the same way (Apple M1 Pro, Tesla T4 measured).",
    "measured": "Not promised: the maximum distance from the reference is measured per adapter by `oxfuse gpu-selftest`."
  },
  "backends": [
    "reference",
    "cpu",
    "gpu"
  ],
