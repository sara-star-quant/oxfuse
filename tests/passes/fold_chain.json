{
  "format_version": 1,
  "inputs": [{ "name": "x", "dtype": "f32", "shape": [2] }],
  "constants": [
    { "name": "a", "dtype": "f32", "shape": [2], "values": [1.0, -2.0] },
    { "name": "b", "dtype": "f32", "shape": [2], "values": [3.0, 4.0] }
  ],
  "nodes": [
    { "name": "s", "op": "Add", "inputs": ["a", "b"] },
    { "name": "r", "op": "Relu", "inputs": ["s"] },
    { "name": "y", "op": "Add", "inputs": ["x", "r"] }
  ],
  "outputs": ["y"]
}
